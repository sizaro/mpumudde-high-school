# Dependencies and package-manager caches
node_modules/
**/node_modules/
.pnpm-store/
**/.pnpm-store/
.npm/
.yarn/cache/
.yarn/unplugged/

# Local environment files and secrets
.env
.env.*
**/.env
**/.env.*

# Safe environment templates are intentionally tracked
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example

# Production and development builds
dist/
**/dist/
build/
**/build/
.vite/
**/.vite/
.cache/
**/.cache/
coverage/
**/coverage/
*.tsbuildinfo

# Vercel and other deployment metadata
.vercel/
**/.vercel/
.netlify/
**/.netlify/

# Logs and diagnostic output
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime and temporary files
*.pid
*.pid.lock
*.seed
*.tmp
*.temp
tmp/
temp/
.tmp/

# Test and tooling output
.nyc_output/
test-results/
playwright-report/
.eslintcache

# IDE and editor settings
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

