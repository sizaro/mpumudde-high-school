generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================
// USERS & AUTHENTICATION
// ==========================

model User {
  id String @id @default(cuid())

  email String @unique

  password String

  isActive Boolean @default(true)

  roles UserRole[]

  director Director?

  teacher Teacher?

  parent Parent?

  uploadedDocuments Document[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

// ==========================
// ROLES & PERMISSIONS
// ==========================

model Role {
  id String @id @default(cuid())

  name String @unique

  description String?

  users UserRole[]

  permissions RolePermission[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Permission {
  id String @id @default(cuid())

  name String @unique

  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

// ==========================
// USER ROLE CONNECTION
// ==========================

model UserRole {
  id String @id @default(cuid())

  userId String

  roleId String

  user User @relation(fields: [userId], references: [id])

  role Role @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

// ==========================
// ROLE PERMISSION CONNECTION
// ==========================

model RolePermission {
  id String @id @default(cuid())

  roleId String

  permissionId String

  role Role @relation(fields: [roleId], references: [id])

  permission Permission @relation(fields: [permissionId], references: [id])

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
}

// ==========================
// DIRECTOR
// ==========================

model Director {
  id String @id @default(cuid())

  firstName String

  lastName String

  phone String?

  userId String @unique

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

// ==========================
// TEACHERS
// ==========================

model Teacher {

  id String @id @default(cuid())


  firstName String

  middleName String?

  lastName String


  gender String?

  dateOfBirth DateTime?


  phone String?

  email String?


  nationality String?


  address String?


  profilePhoto String?



  userId String @unique

  user User @relation(fields: [userId], references: [id])



  employment TeacherEmployment?


  medicalInformation MedicalInformation?


  emergencyContacts EmergencyContact[]


  qualifications Qualification[]


  teachingAssignments TeacherAssignment[]


  attendanceSessions AttendanceSession[]


  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}



model TeacherEmployment {

  id String @id @default(cuid())


  teacherId String @unique


  employeeNumber String @unique


  position String?


  department String?


  employmentType String?


  employmentDate DateTime?


  probationEndDate DateTime?


  salary Int?


  status String @default("active")


  teacher Teacher @relation(fields: [teacherId], references: [id])


  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}



model Subject {

  id String @id @default(cuid())


  name String @unique


  code String?


  isActive Boolean @default(true)


  teachers TeacherAssignment[]


  attendanceSessions AttendanceSession[]


  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}

model TeacherAssignment {

  id String @id @default(cuid())


  teacherId String

  classId String

  subjectId String



  teacher Teacher @relation(fields: [teacherId], references: [id])


  schoolClass SchoolClass @relation(fields: [classId], references: [id])


  subject Subject @relation(fields: [subjectId], references: [id])



  createdAt DateTime @default(now())



  @@unique([teacherId, classId, subjectId])

}

model MedicalInformation {

 id String @id @default(cuid())


 teacherId String @unique


 bloodGroup String?


 allergies String?


 medicalConditions String?


 medication String?


 disability String?


 notes String?



 teacher Teacher @relation(fields: [teacherId], references: [id])


}

model EmergencyContact {

 id String @id @default(cuid())


 teacherId String


 fullName String


 relationship String


 phone String


 alternativePhone String?


 address String?



 isNextOfKin Boolean @default(false)



 teacher Teacher @relation(fields: [teacherId], references: [id])


 createdAt DateTime @default(now())


}

model Document {

  id String @id @default(cuid())

  // ==========================
  // Ownership
  // ==========================

  entityType String
  // TEACHER
  // STUDENT
  // PARENT
  // DIRECTOR
  // SCHOOL
  // FINANCE

  entityId String

  // ==========================
  // Document Category
  // ==========================

  documentCategoryId String

  documentCategory DocumentCategory @relation(fields: [documentCategoryId], references: [id])

  // ==========================
  // File Information
  // ==========================

  title String?

  description String?

  originalFileName String

  storedFileName String?

  fileUrl String

  fileExtension String?
  // pdf
  // jpg
  // png
  // docx

  mimeType String?

  fileSize Int?

  // ==========================
  // Upload Information
  // ==========================

  uploadedByUserId String?

  uploadedBy User? @relation(fields: [uploadedByUserId], references: [id])

  // ==========================
  // Status
  // ==========================

  isVerified Boolean @default(false)

  verifiedAt DateTime?

  expiresAt DateTime?

  isActive Boolean @default(true)

  // ==========================
  // Audit
  // ==========================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([entityType, entityId])

  @@index([documentCategoryId])

}


model DocumentCategory {

  id String @id @default(cuid())

  name String @unique
  // National ID
  // Passport
  // LC1 Introduction Letter
  // Driving Permit
  // Birth Certificate
  // Academic Certificate
  // Appointment Letter
  // Employment Contract
  // Recommendation Letter
  // Police Clearance
  // Teaching License
  // CV
  // Medical Report
  // Report Card
  // Invoice
  // Receipt
  // Other

  description String?

  entityType String
  // TEACHER
  // STUDENT
  // PARENT
  // DIRECTOR
  // FINANCE
  // SCHOOL
  // GENERAL

  isRequired Boolean @default(false)

  isActive Boolean @default(true)

  allowMultiple Boolean @default(true)

  documents Document[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}

model Qualification {

  id String @id @default(cuid())

  teacherId String

  qualificationType String?
  // Certificate
  // Diploma
  // Bachelor's Degree
  // Master's Degree
  // PhD
  // Professional Certification
  // Other

  qualificationName String
  // Bachelor of Science with Education

  institution String

  specialization String?
  // Mathematics
  // Physics
  // ICT

  grade String?
  // First Class
  // Second Upper
  // Credit
  // Distinction

  yearStarted Int?

  yearCompleted Int?

  certificateNumber String?

  documentUrl String?

  teacher Teacher @relation(fields: [teacherId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}


model AttendanceSession {

  id String @id @default(cuid())


  teacherId String

  classId String

  subjectId String


  date DateTime @default(now())


  teacher Teacher @relation(fields: [teacherId], references: [id])


  schoolClass SchoolClass @relation(fields: [classId], references: [id])


  subject Subject @relation(fields: [subjectId], references: [id])


  records AttendanceRecord[]


  createdAt DateTime @default(now())


}


model AttendanceRecord {

  id String @id @default(cuid())


  attendanceSessionId String


  studentId String


  status String
  // Present
  // Absent
  // Late
  // Excused



  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id])


  student Student @relation(fields: [studentId], references: [id])


  createdAt DateTime @default(now())


}



// ==========================
// PARENTS
// ==========================

model Parent {
  id String @id @default(cuid())

  firstName String

  lastName String

  phone String?

  relationship String?
  // Father
  // Mother
  // Guardian

  userId String @unique

  user User @relation(fields: [userId], references: [id])

  students StudentParent[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

// ==========================
// STUDENTS
// ==========================

model Student {

  id String @id @default(cuid())


  admissionNumber String @unique


  firstName String


  lastName String


  dateOfBirth DateTime?


  gender String?


  passportPhoto String?


  isActive Boolean @default(true)


  academicYearId String?


  termId String?


  classId String?


  studentCategoryId String?



  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])


  term Term? @relation(fields: [termId], references: [id])


  schoolClass SchoolClass? @relation(fields: [classId], references: [id])


  studentCategory StudentCategory? @relation(fields: [studentCategoryId], references: [id])



  parents StudentParent[]


  payments Payment[]


  termFees StudentTermFee[]


  attendanceRecords AttendanceRecord[]



  createdAt DateTime @default(now())


  updatedAt DateTime @updatedAt

}

// ==========================
// STUDENT - PARENT RELATION
// ==========================

model StudentParent {
  id String @id @default(cuid())

  studentId String

  parentId String

  relationship String?
  // Father
  // Mother
  // Guardian

  student Student @relation(fields: [studentId], references: [id])

  parent Parent @relation(fields: [parentId], references: [id])

  createdAt DateTime @default(now())

  @@unique([studentId, parentId])
}

// ==========================
// ACADEMIC SETUP & FEES
// ==========================

model AcademicYear {
  id String @id @default(cuid())

  name String @unique

  isActive Boolean @default(true)

  terms Term[]

  financeStructures FinanceStructure[]

  students Student[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Term {
  id String @id @default(cuid())

  name String
  // e.g., "Term 1 2024", "Term 2 2024"

  academicYearId String

  feeAmount Int @default(0)
  // e.g., 1000000 for 1 million shillings

  startDate DateTime?

  endDate DateTime?

  isActive Boolean @default(true)

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  studentTermFees StudentTermFee[]

  financeStructures FinanceStructure[]

  students Student[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([academicYearId, name])
}

model SchoolClass {
  id String @id @default(cuid())

  name String @unique

  isActive Boolean @default(true)

  students Student[]

  teachers TeacherAssignment[]

  attendanceSessions AttendanceSession[]

  financeStructures FinanceStructure[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model StudentCategory {
  id String @id @default(cuid())

  name String @unique

  isActive Boolean @default(true)

  students Student[]

  financeStructures FinanceStructure[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model FeeType {
  id String @id @default(cuid())

  name String @unique

  isActive Boolean @default(true)

  financeStructures FinanceStructure[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model FinanceStructure {
  id String @id @default(cuid())

  academicYearId String

  termId String

  classId String

  studentCategoryId String

  feeTypeId String

  expectedAmount Int

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  term Term @relation(fields: [termId], references: [id])

  schoolClass SchoolClass @relation(fields: [classId], references: [id])

  studentCategory StudentCategory @relation(fields: [studentCategoryId], references: [id])

  feeType FeeType @relation(fields: [feeTypeId], references: [id])

  payments Payment[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([academicYearId, termId, classId, studentCategoryId, feeTypeId])
}

model StudentTermFee {
  id String @id @default(cuid())

  studentId String

  termId String

  amountOwed Int

  amountPaid Int @default(0)

  student Student @relation(fields: [studentId], references: [id])

  term Term @relation(fields: [termId], references: [id])

  payments Payment[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([studentId, termId])
}

model Payment {
  id String @id @default(cuid())

  studentId String

  studentTermFeeId String?

  financeStructureId String?

  amount Int

  method String

  status String @default("completed")

  description String?

  date DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  studentTermFee StudentTermFee? @relation(fields: [studentTermFeeId], references: [id])

  financeStructure FinanceStructure? @relation(fields: [financeStructureId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}
