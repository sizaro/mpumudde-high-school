# Database and authentication
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=replace-with-a-long-random-production-secret

# Comma-separated browser origins that can use the portal API.
FRONTEND_URLS=http://localhost:5173

# Optional email delivery for communication-contact verification and future
# school communications. Contacts can still be recorded when these are absent,
# but no verification email can be delivered until configured.
RESEND_API_KEY=
EMAIL_FROM=Mpumudde High School <noreply@your-verified-domain.example>
