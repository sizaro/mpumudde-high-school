# Database and authentication
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=replace-with-a-long-random-production-secret

# Comma-separated browser origins that can use the portal API.
FRONTEND_URLS=http://localhost:5173

# Official school email delivery. The existing SchoolEmailService uses a Gmail
# account protected by a Google App Password; never use the account password.
GMAIL_USER=official-school-email@example.com
GMAIL_APP_PASSWORD=replace-with-a-google-app-password

# Cloudinary is required for Director communication images and uploaded videos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. Supply only a real, publicly accessible official MHS logo URL.
# The email renderer uses its text identity until an official logo asset exists.
SCHOOL_EMAIL_LOGO_URL=
